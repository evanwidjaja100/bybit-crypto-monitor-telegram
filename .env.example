# Copy this file to `.env` and fill in real values.
# Never commit the `.env` file. Never put real credentials in this example file.

# --- Bybit ---
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_WS_BASE_URL=wss://stream.bybit.com/v5/public

# --- Telegram (placeholders only - fill in .env) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alert rules ---
ALERT_THRESHOLD_PERCENT=5.0
MIN_QUALIFYING_COINS=1
MAX_QUALIFYING_COINS=3

# --- Alert layers ---
IMMEDIATE_TRANSITION_ALERTS=true
HOURLY_ACTIVE_ALERTS=true
COMPOSITION_CHANGE_ALERTS=false
LISTING_NOTIFICATIONS_ENABLED=true
ALERT_DEBOUNCE_SECONDS=20
COMPOSITION_CHANGE_COOLDOWN_SECONDS=300

# --- Polling / refresh intervals (seconds) ---
INSTRUMENT_REFRESH_SECONDS=300
ANNOUNCEMENT_REFRESH_SECONDS=300
REST_TICKER_POLL_SECONDS=10
SPOT_SAMPLE_SECONDS=60

# --- Market universe ---
# Supported in this release: Spot, Linear USDT, Linear USDC.
# Inverse and Options are NOT supported (no inverse monitoring paths exist).
# Legacy ENABLE_INVERSE from an old .env is ignored by the parser.
ENABLE_SPOT=true
ENABLE_LINEAR_USDT=true
ENABLE_LINEAR_USDC=true
ENABLE_WEBSOCKET=true
REST_FALLBACK_ENABLED=true

# --- Storage ---
# Local development path. The docker-compose stack overrides this with
# DATABASE_PATH=/data/bybit_monitor.sqlite so data lives on a volume.
DATABASE_PATH=./data/bybit_monitor.sqlite

# --- Persistence / sampling tuning ---
SPOT_HISTORY_RETENTION_SECONDS=7200
SPOT_ANCHOR_TOLERANCE_SECONDS=90

# --- Network tuning ---
REST_TIMEOUT_SECONDS=10
REST_MAX_RETRIES=3
TELEGRAM_TIMEOUT_SECONDS=15
TELEGRAM_MAX_RETRIES=3

# --- WebSocket tuning ---
WS_HEARTBEAT_INTERVAL_SECONDS=20
WS_STALE_SECONDS=60
WS_SUBSCRIBE_BATCH_SIZE=10
# A subscribe request without a successful Bybit ACK within this window
# triggers a reconnect (topics are confirmed only by ACK).
WS_SUBSCRIPTION_ACK_TIMEOUT_SECONDS=10

# --- Dispatcher / delivery ---
DISPATCHER_POLL_SECONDS=2
# Pause after an unexpected worker error before retrying the loop.
DISPATCHER_ERROR_BACKOFF_SECONDS=5
NOTIFICATION_MAX_AGE_SECONDS=7200
LISTING_NOTIFICATION_MAX_AGE_SECONDS=86400

# --- Observability ---
LOG_LEVEL=INFO
HEALTH_SUMMARY_SECONDS=60
